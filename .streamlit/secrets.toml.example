# Copy to .streamlit/secrets.toml (git-ignored) and fill in your F1 account.
# Only scripts/build_data.py uses it: FastF1 needs a signed-in F1 account for lap timing.
# The app itself reads nothing from here, so the deployed app needs no secrets.
[f1_credentials]
username = "you@example.com"
password = "your-password"
